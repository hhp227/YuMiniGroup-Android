<?xml version="1.0" encoding="utf-8"?>
<layout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".activity.SettingsActivity">

    <data>
        <import type="com.hhp227.yu_minigroup.app.EndPoint" />

        <variable
                name="memberItem"
                type="com.hhp227.yu_minigroup.dto.MemberItem" />

        <variable
                name="cookie"
                type="String" />
    </data>

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:orientation="horizontal">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="7dp"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:paddingTop="7dp">

                <ImageView
                        android:id="@+id/iv_profile_image"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:padding="5dp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/user_image_view_circle"
                        android:scaleType="fitCenter"
                        app:userImageUrl="@{EndPoint.USER_IMAGE.replace(`{UID}`, memberItem.uid)}"
                        app:cookie="@{cookie}" />

                <TextView
                        android:id="@+id/column1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{memberItem.name}"
                        tools:text="행1" />

            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="7dp"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:paddingTop="7dp">

                <TextView
                        android:id="@+id/column2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{memberItem.dept}"
                        tools:text="행2" />

            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="7dp"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:paddingTop="7dp">

                <TextView
                        android:id="@+id/column3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{memberItem.div}"
                        tools:text="행3" />

            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="7dp"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:paddingTop="7dp">

                <TextView
                        android:id="@+id/column4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{memberItem.regDate}"
                        tools:text="행4" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</layout>