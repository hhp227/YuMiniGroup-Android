<?xml version="1.0" encoding="utf-8"?>
<layout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.hhp227.yu_minigroup.app.EndPoint" />

        <variable
                name="memberItem"
                type="com.hhp227.yu_minigroup.dto.MemberItem" />

        <variable
                name="cookie"
                type="String" />
    </data>

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <RelativeLayout
                android:id="@+id/rl_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">

            <ImageView
                    android:id="@+id/iv_profile_image"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:padding="5dp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/user_image_view"
                    android:scaleType="fitCenter"
                    app:memberImageUrl="@{EndPoint.USER_IMAGE.replace(`{UID}`, memberItem.uid)}"
                    app:cookie="@{cookie}" />

        </RelativeLayout>

        <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_profile"
                android:layout_centerHorizontal="true"
                android:text="@{memberItem.name}"
                android:textSize="8dp" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="2px"
                android:layout_alignParentRight="true"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_below="@+id/tv_name"
                android:background="@android:color/white" />

    </RelativeLayout>

</layout>