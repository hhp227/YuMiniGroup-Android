<?xml version="1.0" encoding="utf-8"?>
<layout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />

        <import type="com.hhp227.yu_minigroup.app.EndPoint" />

        <variable
                name="messageItem"
                type="com.hhp227.yu_minigroup.dto.MessageItem" />

        <variable
                name="timeStamp"
                type="String" />

        <variable
                name="separated"
                type="boolean" />

        <variable
                name="timestampVisible"
                type="boolean" />

        <variable
                name="cookie"
                type="String" />
    </data>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_message"
            android:gravity="right"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingRight="5dp"
            android:paddingBottom="5dp"
            app:messageSeparated="@{separated}">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="5dp">

                <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textColor="#777777"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:text="@{messageItem.name}"
                        android:visibility="gone" />

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                    <TextView
                            android:id="@+id/tv_timestamp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="50dp"
                            android:paddingBottom="2dp"
                            android:text="@{timeStamp}"
                            android:textSize="10dp"
                            android:visibility="@{timestampVisible ? View.VISIBLE : View.INVISIBLE}" />

                    <TextView
                            android:id="@+id/tv_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_my_msg"
                            android:padding="9dp"
                            android:textColor="#0a2332"
                            android:text="@{messageItem.message}"
                            android:textSize="16dp" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                    android:id="@+id/iv_profile_image"
                    android:layout_width="0dp"
                    android:layout_height="41dp"
                    android:src="@null"
                    android:scaleType="fitCenter"
                    app:messageHeaderVisible="@{separated}"
                    app:userImageUrl="@{separated ? EndPoint.USER_IMAGE.replace(`{UID}`, messageItem.from != null ? messageItem.from : `{Null}`) : null}"
                    app:cookie="@{cookie}" />

        </LinearLayout>

    </LinearLayout>

</layout>